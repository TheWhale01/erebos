{
  config,
  pkgs,
  env,
  ...
}:
{
  imports = [
    ./hardware-configuration.nix
    ./containers
    ./services
    ./secrets.nix
    ./disko/${env}.nix
    ./packages.nix
  ];

  programs.zsh.enable = true;
  programs.nix-ld.enable = true;

  nix = {
    optimise.automatic = true;
    gc = {
      automatic = true;
      dates = "daily";
    };
    settings = {
      auto-optimise-store = true;
      experimental-features = [
        "nix-command"
        "flakes"
      ];
      trusted-users = [ "hades" ];
      download-buffer-size = 500000000; # 500 MB
    };
  };

  nixpkgs.overlays = [
    (final: prev: {
      redis = prev.redis.overrideAttrs (old: {
        doCheck = false;
      });
    })
  ];

  boot.loader.systemd-boot.enable = true;
  boot.binfmt.emulatedSystems = [ "aarch64-linux" ];
  boot.loader.efi.canTouchEfiVariables = true;
  boot.kernelPackages = pkgs.linuxPackages_latest;
  boot.kernel.sysctl = {
    "net.ipv4.ip_forward" = 1;
  };
  boot.initrd.systemd.enable = false;

  networking = {
    hostName = if env == "prod" then "erebos" else "erebos-${env}";
    networkmanager.enable = true;
    firewall = {
      enable = true;
      checkReversePath = "loose";
      allowedTCPPorts = [ 80 443 ];
      trustedInterfaces = [ "podman0" "tailscale0" ];
    };
    enableIPv6 = true;
    nameservers = [
      "9.9.9.9"
      "149.112.112.112"
    ];
    interfaces = {
      enp7s0 = {
        wakeOnLan.enable = true;
      };
    };
  };

  time.timeZone = "Europe/Paris";

  users.users.hades = {
    isNormalUser = true;
    extraGroups = [
      "wheel"
      "libvirtd"
      "video"
      "input"
      "uinput"
      "render"
      "audio"
      "keys"
    ];
    shell = pkgs.zsh;
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMircTS6VhZz/0Hc1pwYYl/Eov7MXNKd9rJLYjGMRfZz poseidon@pontos"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILAeeNJZnFaAp8AWeq1f/R13J3hr0YTEsfFx9vdcpgtK athena@strategos"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFiTb/R0EMli7oAlf6WFaSj/HR95QkatL8abnhfkoUrI Generated By Termius"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM25SgGES1eclegLiVqRCNyhpK+k4GnFQJvw9p3o65Eb hades@erebos-stage"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK9FADovUTXSn2694wMAViLnDJRn3TypRSzGHy3MNTo9"
    ];
    hashedPasswordFile = config.age.secrets.hades.path;
  };

  virtualisation.libvirtd = {
    enable = true;
    qemu = {
      package = pkgs.qemu_kvm;
      runAsRoot = true;
      swtpm.enable = true;
    };
  };

  environment.sessionVariables = rec {
    TERM = "xterm-256color";
    EDITOR = "vim";
  };

  system.autoUpgrade = {
    enable = true;
    allowReboot = true;
    dates = "Sun 04:00";
    randomizedDelaySec = "30min";
  };
  system.stateVersion = "24.11";
}
